# =============================================================================
# AutoTrade Trader — 환경변수 설정
# =============================================================================
# 각 심볼별 봇은 아래 변수를 참조합니다.
# PM2로 실행할 경우 ecosystem.config.cjs의 env 블록에서 TARGET_SYMBOL, PORT,
# INITIAL_CAPITAL 등 비민감 설정을 관리하고, API 키는 이 .env 파일에 저장하세요.

# ── 공통 ─────────────────────────────────────────────────────────────────────
# API 서버 인증 토큰 — 프론트엔드 VITE_BOT_API_TOKEN과 동일하게 설정
API_TOKEN=충분히_긴_랜덤_문자열

# ── DB 저장 키 사용 (선택) ───────────────────────────────────────────────────
# 두 값을 모두 설정하면 봇이 부팅 시 Spring 내부 API에서 키를 받아 사용한다.
# (미설정/조회 실패 시 아래 env BITGET_*_KEY 값으로 fallback)
# INTERNAL_API_TOKEN 은 Spring 의 app.bot.api-token(BOT_API_TOKEN) 과 동일해야 함.
# INTERNAL_API_URL=http://localhost:8080
# INTERNAL_API_TOKEN=Spring_BOT_API_TOKEN_과_동일한_값

# 거래 데이터 저장 디렉토리 (기본값: ./data)
TRADE_DATA_DIR=./data

# ── 심볼별 서브계정 API 키 ───────────────────────────────────────────────────
# 각 심볼의 봇은 TARGET_SYMBOL 값에 따라 아래 환경변수를 참조합니다.
# (예: TARGET_SYMBOL=SOLUSDT → BITGET_API_KEY 환경변수에서 키를 읽음)
# PM2 ecosystem.config.cjs에서는 BITGET_API_KEY 값만 각 프로세스 env에 매핑합니다.

# SOLUSDT
BITGET_SOL_API_KEY=여기에_API_KEY_입력
BITGET_SOL_SECRET_KEY=여기에_SECRET_KEY_입력
BITGET_SOL_PASSPHRASE=여기에_PASSPHRASE_입력

# NEARUSDT
BITGET_NEAR_API_KEY=여기에_API_KEY_입력
BITGET_NEAR_SECRET_KEY=여기에_SECRET_KEY_입력
BITGET_NEAR_PASSPHRASE=여기에_PASSPHRASE_입력

# LTCUSDT
BITGET_LTC_API_KEY=여기에_API_KEY_입력
BITGET_LTC_SECRET_KEY=여기에_SECRET_KEY_입력
BITGET_LTC_PASSPHRASE=여기에_PASSPHRASE_입력

# WLDUSDT
BITGET_WLD_API_KEY=여기에_API_KEY_입력
BITGET_WLD_SECRET_KEY=여기에_SECRET_KEY_입력
BITGET_WLD_PASSPHRASE=여기에_PASSPHRASE_입력

# INJUSDT
BITGET_INJ_API_KEY=여기에_API_KEY_입력
BITGET_INJ_SECRET_KEY=여기에_SECRET_KEY_입력
BITGET_INJ_PASSPHRASE=여기에_PASSPHRASE_입력

# BTCUSDT
BITGET_BTC_API_KEY=여기에_API_KEY_입력
BITGET_BTC_SECRET_KEY=여기에_SECRET_KEY_입력
BITGET_BTC_PASSPHRASE=여기에_PASSPHRASE_입력

# 1000SHIBUSDT
BITGET_SHIB_API_KEY=여기에_API_KEY_입력
BITGET_SHIB_SECRET_KEY=여기에_SECRET_KEY_입력
BITGET_SHIB_PASSPHRASE=여기에_PASSPHRASE_입력

# ── 메인 계정 (autotrade-main, 전체 포지션 모니터링용) ─────────────────────────
BITGET_MAIN_API_KEY=여기에_MAIN_API_KEY_입력
BITGET_MAIN_SECRET_KEY=여기에_MAIN_SECRET_KEY_입력
BITGET_MAIN_PASSPHRASE=여기에_MAIN_PASSPHRASE_입력

# ── 각 봇 프로세스에서 참조하는 범용 변수 (PM2 env 매핑용) ──────────────────
# BITGET_API_KEY       — 봇이 사용할 서브계정 API 키
# BITGET_SECRET_KEY    — 봇이 사용할 서브계정 시크릿 키
# BITGET_PASSPHRASE    — 봇이 사용할 서브계정 패스프레이즈
# TARGET_SYMBOL        — 거래 심볼 (예: SOLUSDT)
# PORT                 — API 서버 포트 (기본: 3001)
# INITIAL_CAPITAL      — 총수익률 기준 초기 자본금 USDT (기본: 10)