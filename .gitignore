# 데이터 수집 산출물 (스크립트로 재생성 — 대용량, 추적 제외)
ops/verify/fixtures/full/*
# 예외: 해설집 파이프라인이 쓰는 캔들(1M·1w·3d·1d·4h, 합 ~3.2MB)만 추적한다.
#       소스 재생성엔 1M~1d, 브리핑 렌더(4H 이벤트 줌, gen_brief_lw)엔 4h가 필요하다.
#       intraday 1h·30m·15m(~70MB)는 계속 제외한다 (DECISIONS 2026-07-21 (2)).
!ops/verify/fixtures/full/BTCUSDT/
ops/verify/fixtures/full/BTCUSDT/*
!ops/verify/fixtures/full/BTCUSDT/BTCUSDT-1M.json
!ops/verify/fixtures/full/BTCUSDT/BTCUSDT-1w.json
!ops/verify/fixtures/full/BTCUSDT/BTCUSDT-3d.json
!ops/verify/fixtures/full/BTCUSDT/BTCUSDT-1d.json
